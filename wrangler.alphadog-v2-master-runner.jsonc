{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alphadog-v2-master-runner",
  "main": "./alphadog-v2-master-runner.js",
  "compatibility_date": "2026-05-18",
  "observability": {
    "enabled": true
  },
  "vars": {},
  "d1_databases": [],
  "limits": {
    "cpu_ms": 300000
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f6c6e778ebfe4dfa8e17d7effbeaff8b"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "BOARD_RUNNER_WORKER",
      "service": "alphadog-v2-board-runner"
    },
    {
      "binding": "DAILY_CONTEXT_RUNNER_WORKER",
      "service": "alphadog-v2-daily-context-runner"
    },
    {
      "binding": "MARKET_RUNNER_WORKER",
      "service": "alphadog-v2-market-runner"
    },
    {
      "binding": "SCORING_RUNNER_WORKER",
      "service": "alphadog-v2-scoring-runner"
    }
  ],
  "triggers": {
    "crons": [
      "0 16 * * *",
      "0 20 * * *",
      "0 5 * * *"
    ]
  }
}
