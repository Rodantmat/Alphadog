{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alphadog-v2-gbdt-auto-trigger",
  "main": "./alphadog-v2-gbdt-auto-trigger.js",
  "compatibility_date": "2026-05-18",
  "observability": {
    "enabled": true
  },
  "vars": {
    "SYSTEM_ENV": "production",
    "SYSTEM_FAMILY": "alphadog-v2",
    "SYSTEM_VERSION": "v2.0.0"
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "alphadog-v2-control-db",
      "database_id": "13cd2d5d-6817-4d5c-88d6-2b7d0a52722a"
    },
    {
      "binding": "CONFIG_DB",
      "database_name": "alphadog-v2-config-db",
      "database_id": "e55efd67-b2fb-41e2-8dfe-7e2a9ca78f00"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "tail_consumers": [
    {
      "service": "alphadog-v2-tail-logger"
    }
  ]
}
