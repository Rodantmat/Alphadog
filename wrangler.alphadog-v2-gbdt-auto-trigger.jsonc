{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alphadog-v2-gbdt-auto-trigger",
  "main": "./alphadog-v2-gbdt-auto-trigger.js",
  "compatibility_date": "2026-05-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SYSTEM_ENV": "production",
    "SYSTEM_FAMILY": "alphadog-v2",
    "SYSTEM_VERSION": "v2.0.0"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f6c6e778ebfe4dfa8e17d7effbeaff8b"
    }
  ],
  "d1_databases": [],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "tail_consumers": [
    {
      "service": "alphadog-v2-tail-logger"
    }
  ]
}
